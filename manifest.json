{
  "manifest_version": 3,
  "name": "Clearframe — Understand Any Page",
  "short_name": "Clearframe",
  "version": "0.1.0",
  "description": "Summarize pages, compare sources, translate key ideas, and notice obvious risk signals.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Clearframe"
  },
  "options_page": "options.html"
}
