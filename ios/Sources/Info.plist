<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Limeghost</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- False because the architecture cannot serve a second window, and this
	     matters on iPad, which TARGETED_DEVICE_FAMILY = "1,2" includes.
	     `LimeghostApp` holds one `@StateObject` workspace for the whole
	     process, so both scenes would draw the same tab — and `WebViewHost`
	     hands SwiftUI the web view the session already owns, a view that
	     cannot be in two places at once and, as that file notes, cannot be
	     swapped once returned. One window would simply go blank. Tear-off
	     windows sit under "Not on a phone" in the design spec; saying so here
	     is better than advertising a capability to the system and letting
	     somebody discover the blank window. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- A browser renders addresses the person chooses, and plenty of the web
	     is still plain http. This exempts *page content* only: the app's own
	     connections stay under App Transport Security, and Limeghost makes
	     almost none of its own. The macOS bundle carries the same key. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>

	<!-- Shown when a page asks. Both are WebKit permission prompts on the
	     page's behalf; the app records nothing itself. -->
	<key>NSCameraUsageDescription</key>
	<string>A website you are visiting is asking to use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A website you are visiting is asking to use the microphone.</string>
</dict>
</plist>
